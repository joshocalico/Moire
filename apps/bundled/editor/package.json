{
  "name": "@moire/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#editor/*": "./src/*.ts"
  },
  "description": "Edit text documents",
  "scripts": {
    "start": "tsx src/main.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
