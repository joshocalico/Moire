{
  "name": "@moire/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#ui/image/*": "./src/image/*.ts",
    "#ui/layout/*": "./src/layout/*.ts",
    "#ui/motion": "./src/motion.ts",
    "#ui/platform": "./src/platform.ts",
    "#ui/theme": "./src/theme.ts",
    "#ui/widget-theme": "./src/widget-theme.tsx",
    "#ui/widgets/*": "./src/widgets/*.tsx",
    "#ui/window": "./src/window.ts"
  },
  "bin": {
    "moire-ui-smoke": "./src/smoke.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "smoke": "tsx src/smoke.tsx"
  },
  "dependencies": {
    "@moire/prefs": "workspace:*",
    "@moire/protocol": "workspace:*",
    "@moire/react-host": "workspace:*",
    "@moire/sys": "workspace:*",
    "@moire/theme": "workspace:*",
    "opentype.js": "^1.3.4",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
