{
  "name": "@moire/compositor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./startup": "./src/startup.ts"
  },
  "bin": {
    "moire": "./src/main.ts"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../../..",
    "build": "tsc -p tsconfig.json",
    "smoke:capture": "tsx src/capture.smoke.ts"
  },
  "dependencies": {
    "@moire/app-discovery": "workspace:*",
    "@moire/core": "workspace:*",
    "@moire/dbus": "workspace:*",
    "@moire/protocol": "workspace:*",
    "@moire/prefs": "workspace:*",
    "@moire/shell": "workspace:*",
    "@moire/sys": "workspace:*",
    "pngjs": "^7.0.0",
    "@moire/system-management": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/pngjs": "^6.0.5"
  }
}
