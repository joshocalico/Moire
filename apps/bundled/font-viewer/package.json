{
  "name": "@moire/font-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#font-viewer/*": "./src/*.ts"
  },
  "scripts": {
    "start": "tsx src/main.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../../..",
    "smoke": "tsx src/smoke.ts && tsx src/model.smoke.ts && tsx src/workflow.smoke.tsx && tsx src/install.smoke.tsx"
  },
  "dependencies": {
    "@moire/app-tools": "workspace:*",
    "@moire/ui": "workspace:*",
    "react": "^19.0.0",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/opentype.js": "^1.3.10"
  }
}
