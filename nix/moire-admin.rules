// Administrator actions (docs/polkit-agent.md, "Policy changes"). For an active, local session
// these answer "ask for an administrator's password": polkit raises the prompt through Moire's
// authentication agent (the compositor), and accepts the password of any identity in
// security.polkit.adminIdentities (unix-group:wheel). The subject does not have to be an
// administrator: a standard user gets through when an administrator types their own password.
//
// AUTH_ADMIN, never AUTH_ADMIN_KEEP: every check asks. Polkit keeps an authorization for the
// whole session, not for the process that asked (R65 VM): after one admin password, any other
// program in that session could create a user unprompted for five minutes.
//
// The greeter account, and any subject not in an active, local session, gets an explicit NO for
// these actions before the prompt branch, so no AUTH_* answer ever reaches them.
//
// The list is explicit and every addition is a separate approval. Everything else falls through
// to the 00-moire-*.rules allowances and then the immutable 01-moire-deny-unapproved.rules.
polkit.addRule(function(action, subject) {
  var administrator = [
    // moire-accounts: one check per account change, about the app that asked (Settings).
    // AccountsService's own user-administration is not here: 00-moire-accounts.rules grants it
    // to moire-accounts and refuses it to every session, with no prompt.
    "org.moire.accounts.administer",
    // moire-dm-settings: automatic login for the caller's own account, or off. Settings calls
    // it itself, so the prompt names Settings.
    "org.moire.dm.set-autologin"
  ];
  if (administrator.indexOf(action.id) === -1) return;
  if (subject.user === "root") return;
  // moire-dm's pre-login account (users.users.greeter in nix/moire-dm.nix).
  if (subject.user === "greeter" || subject.isInGroup("greeter")) return polkit.Result.NO;
  if (subject.local !== true || subject.active !== true) return polkit.Result.NO;
  return polkit.Result.AUTH_ADMIN;
});
