{
  "name": "@moire/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated.ts",
    "./surface-state": "./src/surface-state.generated.ts",
    "./xdg-activation": "./src/xdg-activation.generated.ts"
  },
  "scripts": {
    "generate": "pnpm --workspace-root exec tsx scripts/generate-wayland-protocol.ts --output packages/protocol/src/generated.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --workspace-root exec tsc -p scripts/tsconfig.wayland-generator.json",
    "build": "tsc -p tsconfig.json",
    "smoke:generated": "tsx src/generated.smoke.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
