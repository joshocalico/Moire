#!/usr/bin/env bash
# moire-session — start a Moire Wayland session with a D-Bus session bus,
# then launch day-0 apps once the compositor socket is ready.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Moire}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Moire}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export GDK_BACKEND="${GDK_BACKEND:-wayland}"
# GTK/GSK: virgl path still SIGSEGVs on Parallels; Cairo is the day-0 renderer.
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
export PATH="$HOME/.local/bin:$PATH"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Moire GTK theme helpers (LibreOffice GTK3 CSD + libadwaita dark chrome).
# shellcheck source=apply-gtk-theme.sh
source "${ROOT}/apps/session/apply-gtk-theme.sh"

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
  # Prefer a home-stable dir: /run/user/$UID is deleted by systemd when there
  # is no logind session / linger (common for our runuser-based guest session).
  export XDG_RUNTIME_DIR="$HOME/.moire-runtime"
fi
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# Install the development-tree portal backend into this session's XDG roots.
# The D-Bus daemon can then activate it on demand when xdg-desktop-portal asks
# for Moire's AppChooser implementation.
mkdir -p \
  "$XDG_DATA_HOME/dbus-1/services" \
  "$XDG_DATA_HOME/xdg-desktop-portal/portals" \
  "$XDG_DATA_HOME/xdg-desktop-portal"
cp "$ROOT/apps/portal/moire.portal" \
  "$XDG_DATA_HOME/xdg-desktop-portal/portals/moire.portal"
cp "$ROOT/apps/portal/moire-portals.conf" \
  "$XDG_DATA_HOME/xdg-desktop-portal/moire-portals.conf"
cat >"$XDG_DATA_HOME/dbus-1/services/org.freedesktop.impl.portal.desktop.moire.service" <<EOF
[D-BUS Service]
Name=org.freedesktop.impl.portal.desktop.moire
Exec=$ROOT/apps/portal/moire-portal
EOF

if [[ -z "${MOIRE_COMPOSITOR:-}" ]]; then
  MOIRE_COMPOSITOR="pnpm --dir ${ROOT} --filter @moire/compositor exec tsx src/main.ts"
fi
SOCKET="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"

if ! command -v dbus-run-session >/dev/null 2>&1; then
  echo "moire-session: dbus-run-session not found; install dbus" >&2
  exit 1
fi

echo "Moire session: XDG_CURRENT_DESKTOP=$XDG_CURRENT_DESKTOP"
echo "Moire session: XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
echo "Moire session: WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
echo "Moire session: GSK_RENDERER=$GSK_RENDERER"

session_inner() {
  set -euo pipefail
  # Apply theme inside the D-Bus session so gsettings hits this bus.
  moire_apply_gtk_theme

  # Register the native Files app as Moire's directory handler. xdg-open
  # resolves a directory to the inode/directory default in mimeapps.list,
  # then launches this desktop entry with the directory URI.
  local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  mkdir -p "$HOME/.local/bin" "$data_home/applications"
  ln -sfn "$ROOT/apps/files/moire-files" "$HOME/.local/bin/moire-files"
  cp "$ROOT/apps/files/moire-files.desktop" \
    "$data_home/applications/moire-files.desktop"
  ln -sfn "$ROOT/apps/showcase/moire-showcase" "$HOME/.local/bin/moire-showcase"
  cp "$ROOT/apps/showcase/moire-showcase.desktop" \
    "$data_home/applications/moire-showcase.desktop"
  ln -sfn "$ROOT/apps/terminal/moire-terminal" "$HOME/.local/bin/moire-terminal"
  cp "$ROOT/apps/terminal/moire-terminal.desktop" \
    "$data_home/applications/moire-terminal.desktop"
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$data_home/applications" >/dev/null 2>&1 || true
  fi
  if command -v xdg-mime >/dev/null 2>&1; then
    xdg-mime default moire-files.desktop inode/directory
    echo "Moire session: default inode/directory=$(xdg-mime query default inode/directory)"
  else
    echo "moire-session: xdg-mime not found; Files default not registered" >&2
  fi

  rm -f "$SOCKET" "$SOCKET.lock"

  # shellcheck disable=SC2086
  bash -c "$MOIRE_COMPOSITOR" &
  local comp_pid=$!

  cleanup() {
    if [[ -n "${comp_pid:-}" ]]; then
      kill "$comp_pid" 2>/dev/null || true
    fi
    jobs -p | xargs -r kill 2>/dev/null || true
  }
  trap cleanup EXIT INT TERM

  local i
  for i in $(seq 1 150); do
    if [[ -S "$SOCKET" ]]; then
      break
    fi
    if ! kill -0 "$comp_pid" 2>/dev/null; then
      echo "moire-session: compositor exited before socket appeared" >&2
      exit 1
    fi
    sleep 0.1
  done
  if [[ ! -S "$SOCKET" ]]; then
    echo "moire-session: timed out waiting for $SOCKET" >&2
    exit 1
  fi
  echo "Moire session: compositor ready ($SOCKET)"

  # Wait for Xwayland to publish DISPLAY (written to $XDG_RUNTIME_DIR/moire-display).
  DISPLAY_FILE="$XDG_RUNTIME_DIR/moire-display"
  for i in $(seq 1 100); do
    if [[ -f "$DISPLAY_FILE" ]]; then
      DISPLAY="$(tr -d '[:space:]' < "$DISPLAY_FILE")"
      export DISPLAY
      export MOIRE_XWAYLAND=1
      echo "Moire session: X11 DISPLAY=$DISPLAY"
      break
    fi
    if ! kill -0 "$comp_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if [[ -z "${DISPLAY:-}" ]]; then
    echo "Moire session: Xwayland DISPLAY not ready (X11 apps need DISPLAY)" >&2
  fi

  (
    cd "$ROOT" && \
    MOIRE_UI_PLATFORM=wayland \
    pnpm --filter @moire/terminal-app start \
      >/tmp/moire-terminal.log 2>&1 &
  )
  echo "Moire session: started Terminal"

  (
    cd "$ROOT" && \
    MOIRE_UI_PLATFORM=wayland \
    pnpm --filter @moire/files start \
      >/tmp/moire-files.log 2>&1 &
  )
  echo "Moire session: started Files"

  wait "$comp_pid"
}

export -f session_inner
export -f moire_apply_gtk_theme
export MOIRE_COMPOSITOR SOCKET ROOT XDG_DATA_HOME XDG_CONFIG_HOME
# Run inside one D-Bus session so GTK apps share the bus with the compositor.
exec dbus-run-session -- bash -c 'session_inner'
