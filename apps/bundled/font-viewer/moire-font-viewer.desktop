[Desktop Entry]
Name=Font Viewer
Exec=moire-font-viewer %U
TryExec=moire-font-viewer
Icon=moire-font
Terminal=false
Type=Application
Categories=Utility;Viewer;
MimeType=font/ttf;font/otf;font/collection;application/x-font-ttf;application/x-font-opentype;
OnlyShowIn=Moire;
StartupNotify=true
StartupWMClass=org.moire.FontViewer
