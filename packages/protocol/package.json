{
  "name": "@moire/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated.ts"
  },
  "scripts": {
    "generate": "tsx ../../scripts/generate-wayland-protocol.ts --output src/generated.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ../../scripts/tsconfig.wayland-generator.json",
    "build": "tsc -p tsconfig.json",
    "smoke:generated": "tsx src/generated.smoke.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
