{
  "name": "@moire/notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#notes/*": "./src/*.ts"
  },
  "description": "Keep local notes",
  "scripts": {
    "start": "tsx src/main.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx src/model.smoke.ts && tsx src/smoke.tsx && tsx src/export.smoke.tsx"
  },
  "dependencies": {
    "@moire/app-tools": "workspace:*",
    "@moire/ui": "workspace:*",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "exports": {
    ".": "./src/main.tsx",
    "./store": "./src/store.ts"
  }
}
